   "id": "cell-0",
   "metadata": {},
   "source": [
    "# noesis — GRPO RL Training (Colab GPU)\n",
    "\n",
    "RWKV-7 RL training via GRPO on matrix task curriculum.\n",
    "\n",
    "**Prerequisites (one-time upload to Google Drive):**\n",
    "- `noesis_model.pth` — RWKV-7 base model weights (~6 GB)\n",
    "\n",
    "Everything else (code, tasks) is fetched automatically.\n",
    "\n",
    "**Runtime:** GPU → T4/A100. RAM: High-RAM recommended for 2.9B."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 1: Mount Drive + verify GPU\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "import torch\n",
    "print(f'CUDA: {torch.cuda.is_available()}')\n",
    "if torch.cuda.is_available():\n",
    "    print(f'GPU:  {torch.cuda.get_device_name()}')\n",
    "    print(f'VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB')\n",
    "\n",
    "DRIVE_ROOT = '/content/drive/MyDrive'\n",
    "MODEL_PATH = f'{DRIVE_ROOT}/noesis_model.pth'\n",
    "\n",
    "import os\n",
    "assert os.path.exists(MODEL_PATH), f'Model not found at {MODEL_PATH}'\n",
    "print(f'Model: {os.path.getsize(MODEL_PATH) / 1e9:.2f} GB')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2: Clone repo + install deps\n",
    "import os\n",
    "\n",
    "if not os.path.exists('/content/noesis'):\n",
    "    !git clone --depth 1 https://github.com/Vaniell0/noesis /content/noesis\n",
    "else:\n",
    "    !git -C /content/noesis pull --ff-only\n",
    "\n",
    "os.chdir('/content/noesis')\n",
    "\n",
    "# rwkv inference package\n",
    "!pip install -q rwkv\n",
    "\n",
    "# rwkv-peft for LoRA training\n",
    "!pip install -q -r training/rwkv-peft/requirements.txt 2>/dev/null || \\\n",
    "    pip install -q deepspeed\n",
    "\n",
    "print('Setup done.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3: Generate RL task dataset\n",
    "import sys\n",
    "sys.path.insert(0, '/content/noesis/experiments/A0_eval')\n",
    "sys.path.insert(0, '/content/noesis/experiments/A0_state_probe')\n",
    "\n",
    "os.makedirs('/content/noesis/training/corpus_open', exist_ok=True)\n",
    "\n",
    "TASKS_PATH = '/content/noesis/training/corpus_open/matrix_tasks.jsonl'\n",
    "N_TOKENS = 5_000_000  # ~16k tasks, faster for first run; use 20_000_000 for full\n",
    "\n",
    "!python3 experiments/A0_eval/gen_tasks.py \\\n",
    "    --out {TASKS_PATH} \\\n",
    "    --n-tokens {N_TOKENS} \\\n",
    "    --seed 42\n",
    "\n",
    "import json\n",
    "tasks = [json.loads(l) for l in open(TASKS_PATH)]\n",
    "print(f'Tasks: {len(tasks)}')\n",
    "cats = {}\n",
    "for t in tasks:\n",
    "    cats[t['category']] = cats.get(t['category'], 0) + 1\n",
    "for k, v in sorted(cats.items()):\n",
    "    print(f'  {k}: {v}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4: RL training config\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "RUN_DIR   = '/content/noesis/experiments/rl/runs/grpo_colab_01'\n",
    "DRIVE_RUN = f'{DRIVE_ROOT}/noesis_rl_runs/grpo_colab_01'\n",
    "Path(RUN_DIR).mkdir(parents=True, exist_ok=True)\n",
    "Path(DRIVE_RUN).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Link model to local path for faster access\n",
    "LOCAL_MODEL = '/content/model.pth'\n",
    "if not os.path.exists(LOCAL_MODEL):\n",
    "    print('Copying model to /content (faster I/O)...')\n",
    "    shutil.copy2(MODEL_PATH, LOCAL_MODEL)\n",
    "    print('Done.')\n",
    "\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'Device: {DEVICE}')\n",
    "print(f'Run dir: {RUN_DIR}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5: Run GRPO RL training\n",
    "# Adjust G, epochs, lr for available VRAM / time budget\n",
    "# T4 (16GB): G=4, batch=2, max-new=128\n",
    "# A100 (40GB): G=8, batch=4, max-new=256\n",
    "\n",
    "import subprocess, sys\n",
    "\n",
    "VRAM_GB = torch.cuda.get_device_properties(0).total_memory / 1e9 if torch.cuda.is_available() else 0\n",
    "G        = 8 if VRAM_GB > 30 else 4\n",
    "BATCH    = 4 if VRAM_GB > 30 else 2\n",
    "MAX_NEW  = 256 if VRAM_GB > 30 else 128\n",
    "print(f'VRAM={VRAM_GB:.0f}GB → G={G}, batch={BATCH}, max_new={MAX_NEW}')\n",
    "\n",
    "cmd = [\n",
    "    'python3', 'experiments/rl/train_wordsearch.py',\n",
    "    '--model',  LOCAL_MODEL,\n",
    "    '--tasks',  TASKS_PATH,\n",
    "    '--out',    RUN_DIR,\n",
    "    '--G',      str(G),\n",
    "    '--batch',  str(BATCH),\n",
    "    '--max-new',str(MAX_NEW),\n",
    "    '--lr',     '1e-5',\n",
    "    '--epochs', '1',\n",
    "    '--device', DEVICE,\n",
    "    '--seed',   '42',\n",
    "]\n",
    "print('Command:', ' '.join(cmd))\n",
    "\n",
    "proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n",
    "                        text=True, bufsize=1)\n",
    "for line in proc.stdout:\n",
    "    print(line, end='')\n",
    "proc.wait()\n",
    "print(f'Exit code: {proc.returncode}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6: Save checkpoint to Drive\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "run_path  = Path(RUN_DIR)\n",
    "drive_path = Path(DRIVE_RUN)\n",
    "drive_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for f in run_path.glob('*.pth'):\n",
    "    dest = drive_path / f.name\n",
    "    shutil.copy2(f, dest)\n",
    "    print(f'Saved checkpoint: {dest}')\n",
    "\n",
    "log_src = run_path / 'train_log.jsonl'\n",
    "if log_src.exists():\n",
    "    shutil.copy2(log_src, drive_path / 'train_log.jsonl')\n",
    "    # Print summary\n",
    "    logs = [json.loads(l) for l in open(log_src)]\n",
    "    if logs:\n",
    "        last = logs[-1]\n",
    "        print(f'Last step — loss: {last[\"loss\"]:.4f}, acc: {last[\"accuracy\"]:.2%}')\n",
    "        avg_acc = sum(l['accuracy'] for l in logs) / len(logs)\n",
    "        print(f'Mean accuracy over training: {avg_acc:.2%}')\n",
    "\n",
    "print(f'All saved to Drive: {DRIVE_RUN}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 7: Quick eval on held-out tasks (optional)\n",
    "# Generates fresh tasks with a different seed and scores the checkpoint\n",
    "\n",
    "EVAL_PATH = '/content/eval_tasks.jsonl'\n",
    "CKPT      = str(sorted(Path(RUN_DIR).glob('epoch*.pth'))[-1])  # latest checkpoint\n",
    "\n",
    "!python3 experiments/A0_eval/gen_matrix_wordsearch.py \\\n",
    "    --all-levels --per-level 8 --seed 99 --out {EVAL_PATH}\n",
    "\n",
    "!python3 experiments/A0_eval/eval.py \\\n",
    "    --model {CKPT} \\\n",
    "    --backend rwkv \\\n",
    "    --tasks {EVAL_PATH} \\\n",
    "    --out /content/eval_result \\\n",
    "    --num-predict 256\n",
    "\n",
    "result = json.load(open('/content/eval_result.json'))\n",
    "print(f'Eval accuracy: {result[\"accuracy\"]:.2%}')"
   ]
  }
 ]\n",
"}\n"
