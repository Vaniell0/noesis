# Inverted gitignore: ignore everything, whitelist what we need.
# Directories must be un-ignored for git to traverse into them.
*
!*/

# Top-level project files
!.gitignore
!README.md
!LICENSE

# Docs: only the notes that hypotheses/ cites
!docs/**/*.md

# Hypotheses; the record of a claim is records/<ID>.yml
!hypotheses/**/*.md
!hypotheses/records/*.yml

# Experiments: probes, their code and the results a hypothesis cites
!experiments/**/*.py
!experiments/**/*.md
!experiments/**/*.sh
!experiments/**/*.json
!experiments/**/*.jsonl
!experiments/**/*.toml
!experiments/**/*.yml
!experiments/**/*.yaml
!experiments/**/*.txt
!experiments/**/*.ipynb

# The three modules of the old training pipeline that the probes import
!training/*.py
!training/README.md

# Heavy artifacts — re-block after path whitelist
experiments/**/data/
experiments/**/runs/
experiments/**/wandb/
models/
*.gguf
*.pth
*.pt
*.safetensors
*.bin
*.onnx

# Python
__pycache__/
*.pyc
.venv/
.venv-pilot/
.env

# Editor / OS
.idea/
.vscode/
.DS_Store

# Resume checkpoints of finished probe runs and trajectory dumps: regenerable, not for the remote.
experiments/rl/results/*.partial.json
experiments/rl/results/state_traj_g1d04b_expected_*.json
experiments/rl/results/cot_vs_routes_*.partial.jsonl

# Local only: the vendored peft checkout, a frozen copy of an external write-up, the queue's state
training/rwkv-peft/
experiments/queue/state/
docs/muon-rwkv7-finetuning.prepared-*.md

# Local environments and caches that the allowlist above would otherwise pick up.
**/.venv*/
.pytest_cache/
